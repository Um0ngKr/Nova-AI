
# Copy this file to .env and fill in your own values.
# Never share or commit your .env file.
GROQ_API_KEY=
WEATHER_API_KEY=
DEFAULT_CITY=Kolkata

# Email: use a test mailbox and provider-issued app password, not your normal login password.
EMAIL_ADDRESS=
EMAIL_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Optional Windows executable paths (use your own real paths).
DISCORD_PATH=
STEAM_PATH=
VSCODE_PATH=
MINECRAFT_PATH=
